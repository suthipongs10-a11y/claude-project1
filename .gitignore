# ห้าม commit เด็ดขาด — API keys
**/.env

# ฟุตเทจดาวน์โหลด: ใหญ่เกิน GitHub limit + ลิขสิทธิ์ของเจ้าของคลิป
projects/*/footage/
*.mp4

# metadata ใหญ่จาก yt-dlp
*.info.json

# backup ของ CapCut (อยู่นอกโปรเจกต์อยู่แล้ว แต่กันไว้)
_backups/

# ไฟล์ชั่วคราว
*.zip
__pycache__/

# แคชผลลัพธ์ API — ต้องอยู่นอก repo เพราะโตขึ้นเรื่อยๆ ทุกตอน
# ปกติอยู่ที่ ~/.cache/weird-stories อยู่แล้ว บรรทัดนี้กันกรณีตั้ง WS_CACHE_DIR มาไว้ในนี้
.cache/

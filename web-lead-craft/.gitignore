# Build output. All of this is regenerated by:
#   node tools/build-site.mjs sites/<name>
# Keeping any of it tracked means a local build shows up as a modified file
# and blocks the next git pull, which is exactly what happened once.
sites/*/dist/
sites/*/preview.html
sites/*/preview-*.html

# QA screenshots
sites/*/.qa/

node_modules/
form-worker/sites.json
form-worker/.wrangler/

# Built quotations. The .json beside each one is the source of truth; the
# template is tracked, the assembled document is not.
quotes/*.html
!quotes/_template.html

# Our own identity details. A national ID number and a bank account belong in
# a quotation, not in git history — history is permanent, and the day this
# repo is shared or made public is the day they leak. The .example file
# beside it documents the shape.
quotes/_seller.json

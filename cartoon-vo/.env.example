# คัดลอกเป็น .env แล้วใส่คีย์จริง (ห้าม commit .env)
# ใส่หลายคีย์คั่นด้วย , ได้ — โควตาหมดตัวหนึ่งจะสลับไปตัวถัดไปเอง

# คีย์ Google — ใช้ได้ทั้ง provider "gemini" และ "google"
#   คีย์จาก AI Studio (aistudio.google.com/apikey) → ใช้ได้เฉพาะ provider "gemini"
#   คีย์จาก Google Cloud ที่เปิด Cloud Text-to-Speech API → ใช้ได้ทั้งสองแบบ
GOOGLE_TTS_API_KEY=
GEMINI_API_KEY=

ELEVENLABS_API_KEY=

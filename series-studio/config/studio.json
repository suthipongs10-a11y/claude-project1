{
  "$comment": "Series Studio configuration. Paths are relative to the series-studio folder. Override locally with config/local.json (gitignored). Never hardcode these values in code.",
  "projects_dir": "projects",
  "presets_dir": "presets/styles",
  "logs_dir": "logs",
  "data_dir": "data",
  "export_dir": "exports",
  "tools": {
    "python": "python3",
    "ffmpeg": "ffmpeg",
    "ffprobe": "ffprobe"
  },
  "http": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8787
  },
  "default_engine": "manual",
  "engines": {
    "manual": {
      "maxClipSec": 8,
      "supportsRefImages": true,
      "supportsNativeDialogue": true,
      "creditsPerClip": {
        "draft": 0,
        "final": 0
      }
    },
    "flow_ext": {
      "maxClipSec": 8,
      "supportsRefImages": true,
      "supportsNativeDialogue": true,
      "creditsPerClip": {
        "draft": 20,
        "final": 100
      },
      "minDelayMs": 8000,
      "maxDelayMs": 25000,
      "jobTimeoutSec": 900,
      "selectorsFile": "config/flow-selectors.json"
    }
  },
  "qc": {
    "duration_tolerance": 0.1,
    "cut_tolerance": 1,
    "cer_max": 0.25,
    "identity_similarity_min": 0.5,
    "black_min_sec": 0.3,
    "freeze_min_sec": 1.0,
    "max_regen_attempts": 2,
    "keyframes_per_shot": 3,
    "scdet_threshold": 10,
    "worker_timeout_sec": 1800,
    "whisper_model": "large-v3",
    "whisper_device": "auto",
    "whisper_compute_type": "auto",
    "ocr": false
  },
  "script": {
    "syllables_per_sec": 5.5,
    "episode_length_tolerance": 0.05
  },
  "assembly": {
    "loudness_lufs": -14,
    "subtitle_offset_tolerance_sec": 0.2,
    "ai_label_text": "เนื้อหานี้สร้างด้วย AI",
    "ad_label_text": "โฆษณา",
    "fps": 24,
    "crf": 18,
    "x264_preset": "medium",
    "subtitle_font": "Noto Sans Thai",
    "card_font": "Noto Sans Thai",
    "title_card_sec": 2.0,
    "end_card_sec": 3.0,
    "product_card_sec": 4.0,
    "music_volume": 0.25,
    "draft_scale": 0.5,
    "ai_label_position": "bottom_right"
  },
  "voice": {
    "provider": "mock",
    "max_speedup": 1.25,
    "fit_tolerance_sec": 0.15,
    "cartesia": {
      "api_url": "https://api.cartesia.ai",
      "version": "2025-04-16",
      "model": "sonic-3",
      "sample_rate": 44100
    }
  }
}
